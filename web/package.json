{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-contracts.ts",
    "predev": "npm run sync && node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "npm run sync && node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:quotes": "node scripts/check-quotes.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "resolve": "npm run sync && node scripts/resolve-batch.ts && npm run sync",
    "alerts": "node --env-file-if-exists=.env.local scripts/alerts.ts",
    "seed-subscriber": "node --env-file-if-exists=.env.local scripts/alerts.ts seed",
    "evidence:build": "npm run sync && ${PYTHON:-python3} scripts/building-evidence/build.py && node scripts/build-building-evidence.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@modelcontextprotocol/server": "2.3.0",
    "maplibre-gl": "6.12.0",
    "mcp-handler": "2.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "3.66.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
