  "music": {
    "track": "One continuous cinematic electronic piece for a product video, 112 bpm, in one key, with an arc. First 7 seconds: tension builds, a ticking pulse, a rising synth arpeggio over a low drone and a riser. Then one huge drum hit with a deep bass drop. Right after the hit the same theme keeps going with steady driving drums, pulsing bass and the arpeggio at full energy, never calming down, no breakdown, no quiet piano part. It ends on a confident resolving chord. No vocals.",
    "maxDelay": 3
  },
  "hook": {
    "plain": true,
    "narration": "Three layers of housing law decide your rent. Which ones apply to your home?",
    "lines": [
      "Three layers of housing law decide your rent.",
      "Which ones apply to your home?"
    ],
    "montage": {
      "windows": [
        {
          "kind": "mail",
          "title": "Re: your rent increase"
        },
        {
          "kind": "pdf",
          "title": "Cal. Civ. Code 1947.12.pdf"
        },
        {
          "kind": "pdf",
          "title": "SF Rent Ordinance ch. 37.pdf"
        },
        {
          "kind": "pdf",
          "title": "Mass. S.2983 (pending).pdf"
        },
        {
          "kind": "pdf",
          "title": "NJ FAIR Act, eff. 2027.pdf"
        },
        {
          "kind": "xlsx",
          "title": "Which rules apply.xlsx"
        }
      ],
      "value": "3515 Fillmore St",
      "counter": "searched",
      "arms": true
    }
  },
  "scenes": [
    {
      "id": "search",
      "still": "stills/01_search.png",
      "narration": "Ana rents in San Francisco and just got a rent increase. She types her address. HomeRule finds her building: built 1926, 21 units.",
