        {
          "do": "pause",
          "value": 600
        },
        {
          "do": "fill",
          "target": "role=combobox",
          "value": "3515 Fill"
        },
        {
          "do": "wait",
          "target": "role=option"
        },
        {
          "do": "pause",
          "value": 1200
        },
        {
          "do": "click",
          "target": "role=option"
        },
        {
          "do": "wait",
          "target": "#t-rent"
        },
        {
          "do": "hover",
          "target": "ul.facts"
        }
      ]
    },
    {
      "id": "rent",
      "still": "stills/02_rent.png",
      "narration": "The city limits her increase to 1.6 percent this year. The state cap is replaced here by the city rule, and every line quotes the law, with its date.",
