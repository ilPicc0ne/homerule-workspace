# Brief stays local; starter pack is tracked in this workspace and excluded from public publishing
data/brief/
.env*
!.env.example
node_modules/
.next/
__pycache__/
.venv/
.DS_Store
.worktrees/
# Local copies excluded from the usable corpus after source-terms review
data/supplemental-legal/excluded/

# generated: pinned document versions, model-call cache
build/

# generated by extract/: document index, raw extraction records (rebuilt from corpus + cache)
out/index/
out/inventory.json
out/extracted*/
# model-call log; the build commits a curated audit trail later
audit/
# generated by make extract / make eval (the committed I2/I8 files are rules*.json and findings.json)
out/eval/
out/*_stdout.txt
out/extracted_failures.json
out/link_findings.json
out/open_questions.json
out/changes.json

